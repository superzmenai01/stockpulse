# StockPulse Mini App Bot - Environment Variables Template
#
# Usage:
#   1. Copy this file to miniapp/.env (same directory as bot_command.py)
#   2. Fill in your real values below
#   3. miniapp/.env is gitignored — NEVER commit it
#
# Setup steps:
#   cp miniapp/.env.example miniapp/.env
#   $EDITOR miniapp/.env       # fill real values
#   python3 bot_command.py     # start the bot
#
# Rotate (revoke old token):
#   1. @BotFather on Telegram → /revoke → pick bot → confirm
#   2. /token → create new token
#   3. Update TELEGRAM_BOT_TOKEN below
#   4. Restart the bot

# Telegram Bot Token (get from @BotFather on Telegram)
# Format: <digits>:<35+chars-alphanumeric>
TELEGRAM_BOT_TOKEN=

# Cloudflare Quick Tunnel URL (regenerated each tunnel restart)
# Start tunnel: cloudflared tunnel --url http://localhost:18793
# Then paste the trycloudflare.com URL here
MINIAPP_URL=
