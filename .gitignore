# Dependencies
web/node_modules/

# Logs
logs/
*.log
trigger.log*

# Scratch test scripts (root, debug use only)
test-*.mjs

# Environment
.env
.env.local

# IDE
.idea/
.vscode/

# OS
.DS_Store

# Build
web/dist/
__pycache__/
*.pyc
logs/*.log
*.db
logs/*.log
STRATEGY_CONCEPTS.md

# docs/ sync hash files (managed by LaunchAgent, auto-regenerated)
docs/.strategy_last_sync_hash
docs/.algorithm_last_sync_hash

# docs/ALGORITHM_SPECS.md (auto-synced from MEMORY every 1h by LaunchAgent,
# would conflict on push/pulls; tracked only in workspace MEMORY)
docs/ALGORITHM_SPECS.md

# LLM encryption key (NEVER commit — security risk)
backend/data/.llm_encryption_key

# Vite cache files (auto-regenerated)
web/node_modules/.vite/

# Runtime SQLite DB (per-machine state, schema is migration-tracked)
backend/data/stocks.db

# Backup folders (local-only snapshots, 唔 commit 入 git history — 852K binary)
# Backup metadata 記錄喺 git tag + ARCHITECTURE.md §15.x 章節
backups/


# sed backup files
*.bak
*.bak-*    # 帶 timestamp suffix 嘅 backup (e.g. stocks.db.bak-20260810-before-source-field)
**/*.bak-*  # 同上但匹配 subdirectory 深層 (e.g. backend/data/stocks.db.bak-...)

# Stage 1+ tune results 暫存 (大少 2026-08-10 Hybrid Option 3)
# 真正 tune 結果將來會入 backend/data/ 正式 table
scripts/stage1p_tuning_results.json

# docx files (source binary, 唔 commit)
*.docx
docs/演算法概念SPECS/
.gitignore.test
tmp-zigzag-flag-test.html
