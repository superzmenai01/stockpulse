def test_generate_reason_mcap_top_1():
    """mcap_rank=1 should produce '市值 top 1 (formatted)'."""
    item = {"mcap_rank": 1, "volume_rank": 5, "mcap": 599256419650.0}
    reason = _generate_reason(item)
    assert "市值 top 1" in reason
    assert "5992億" in reason or "6000億" in reason  # formatted mcap


def test_generate_reason_volume_top_1():
    """volume_rank=1 should produce '成交 top 1'."""
    item = {"mcap_rank": 5, "volume_rank": 1, "mcap": 1000.0}
    reason = _generate_reason(item)
    assert "成交 top 1" in reason


def test_generate_reason_no_top():
    """Neither mcap_rank nor volume_rank is 1 or <=3 → fallback."""
    item = {"mcap_rank": 10, "volume_rank": 10, "mcap": 1000.0}
    reason = _generate_reason(item)
    assert "綜合" in reason


