def test_filter_valid_stocks_mixed():
    """Mixed: pre-market + normal + suspended + NaN → correct filtering."""
    snapshots = {
        "HK.00981": make_snapshot("HK.00981", turnover=0.0, total_market_val=599256419650.0),  # pre-market, VALID
        "HK.01347": make_snapshot("HK.01347", turnover=500000.0, total_market_val=300000000000.0),  # normal, VALID
        "HK.00001": make_snapshot("HK.00001", turnover=0.0, suspension=True),  # suspended, SKIP
        "HK.00002": make_snapshot("HK.00002", turnover=float("nan"), total_market_val=100.0),  # NaN, SKIP
    }
    stocks = ["HK.00981", "HK.01347", "HK.00001", "HK.00002", "HK.MISSING"]

    valid = _filter_valid_stocks(snapshots, stocks)

    assert len(valid) == 2
    valid_codes = {v["code"] for v in valid}
    assert valid_codes == {"HK.00981", "HK.01347"}


# ============================================================================
# Test _rank_and_score
# ============================================================================

def test_rank_and_score_basic():
    """_rank_and_score should compute mcap_rank + volume_rank + score."""
    valid = [
        {"code": "A", "mcap": 1000.0, "turnover": 500.0},
        {"code": "B", "mcap": 2000.0, "turnover": 300.0},
        {"code": "C", "mcap": 1500.0, "turnover": 800.0},
    ]

    result = _rank_and_score(valid)

    # mcap_rank: B(2000)=1, C(1500)=2, A(1000)=3
    assert result[1]["mcap_rank"] == 1  # B
    assert result[2]["mcap_rank"] == 2  # C
    assert result[0]["mcap_rank"] == 3  # A

    # volume_rank: C(800)=1, A(500)=2, B(300)=3
    assert result[2]["volume_rank"] == 1  # C
    assert result[0]["volume_rank"] == 2  # A
    assert result[1]["volume_rank"] == 3  # B

    # composite score (sum of ranks, 越低越好)
    assert result[0]["score"] == 5  # A: 3+2=5
    assert result[1]["score"] == 4  # B: 1+3=4
    assert result[2]["score"] == 3  # C: 2+1=3 (best)


