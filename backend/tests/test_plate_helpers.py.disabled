def make_snapshot(code: str, last_price: float = 70.0, total_market_val: float = 599256419650.0,
                  turnover: float = 0.0, suspension: bool = False) -> dict:
    """Mock OpenD snapshot row (dict format, simulating iterrows().to_dict())."""
    return {
        "code": code,
        "name": f"Mock {code}",
        "last_price": last_price,
        "change_rate": 1.0,
        "total_market_val": total_market_val,
        "turnover": turnover,
        "suspension": suspension,
    }


def make_snapshot_df(snapshots: list[dict]) -> pd.DataFrame:
    """Mock OpenD DataFrame response (from ctx.get_market_snapshot)."""
    return pd.DataFrame(snapshots)


# ============================================================================
# Test _filter_etf_structured (大少 2026-07-24)
# ============================================================================

def test_filter_etf_structured_keeps_ordinary_stocks():
    """_filter_etf_structured should keep 普通股 only."""
    stocks = ["HK.00700", "HK.09988", "HK.00981"]  # All ordinary
    result = _filter_etf_structured(stocks)
    assert result == stocks


def test_filter_etf_structured_removes_etf():
    """_filter_etf_structured should remove 02xxx/03xxx/8xxxx (ETF/結構性)."""
    stocks = ["HK.00700", "HK.02807", "HK.09988"]  # 02807 = ETF
    result = _filter_etf_structured(stocks)
    assert result == ["HK.00700", "HK.09988"]


# ============================================================================
# Test _filter_valid_stocks (CRITICAL — 大少 2026-07-24 pre-market fix)
# ============================================================================

def test_filter_valid_stocks_pre_market_zero_turnover_is_valid():
    """
    CRITICAL REGRESSION TEST (大少 2026-07-24 09:03 bug fix).

    Pre-market (09:00-09:30) snapshot has turnover=0.0 but mcap has value.
    Previous bug: filter_valid_stocks skipped → 0 leaders.
    Fix: turnover=0 should NOT be skipped (only NaN / non-numeric).
    """
    snapshots = {
        "HK.00981": make_snapshot("HK.00981", turnover=0.0, total_market_val=599256419650.0),
    }
    stocks = ["HK.00981"]

    valid = _filter_valid_stocks(snapshots, stocks)

    assert len(valid) == 1, "Pre-market stock should be VALID (turnover=0 is OK)"
    assert valid[0]["code"] == "HK.00981"
    assert valid[0]["turnover"] == 0.0  # preserved
    assert valid[0]["mcap"] == 599256419650.0


def test_filter_valid_stocks_normal_trading_hours_valid():
    """正常 trading hours: turnover > 0, mcap > 0 → valid."""
    snapshots = {
        "HK.00981": make_snapshot("HK.00981", turnover=1000000.0, total_market_val=599256419650.0),
    }
    stocks = ["HK.00981"]

    valid = _filter_valid_stocks(snapshots, stocks)

    assert len(valid) == 1


def test_filter_valid_stocks_skips_nan_turnover():
    """turnover=NaN 應該 skip (avoid NaN comparison error)."""
    snapshots = {
        "HK.00981": make_snapshot("HK.00981", turnover=float("nan"), total_market_val=599256419650.0),
    }
    stocks = ["HK.00981"]

    valid = _filter_valid_stocks(snapshots, stocks)

    assert len(valid) == 0, "NaN turnover should be skipped"


def test_filter_valid_stocks_skips_suspended():
    """suspension=True 應該 skip."""
    snapshots = {
        "HK.00981": make_snapshot("HK.00981", turnover=1000000.0, suspension=True),
    }
    stocks = ["HK.00981"]

    valid = _filter_valid_stocks(snapshots, stocks)

