def test_filter_valid_stocks_skips_zero_mcap():
    """mcap=0 (e.g. 公司太細) 應該 skip."""
    snapshots = {
        "HK.00981": make_snapshot("HK.00981", turnover=1000000.0, total_market_val=0.0),
    }
    stocks = ["HK.00981"]

    valid = _filter_valid_stocks(snapshots, stocks)

