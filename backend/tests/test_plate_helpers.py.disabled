def test_fetch_snapshots_success():
    """Mock ctx returning batch of snapshots → dict {code: snapshot}."""
    mock_ctx = Mock()
    snapshot_df = pd.DataFrame([
        make_snapshot("HK.00981", turnover=1000000.0),
        make_snapshot("HK.01347", turnover=500000.0),
