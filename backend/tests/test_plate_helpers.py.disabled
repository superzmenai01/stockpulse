    result = _fetch_snapshots(mock_ctx, ["HK.00981"])

    assert result == {}


# ============================================================================
# Test _lookup_plate_name (mocked DB)
# ============================================================================

def _make_db_mock(fetchone_return):
    """Create a mock DB connection that works as a context manager.
    
    MagicMock 預設 __enter__.return_value 唔係 mock 自己，所以需要 explicit set.
    """
    mock_conn = MagicMock()
    mock_conn.__enter__ = Mock(return_value=mock_conn)
    mock_conn.__exit__ = Mock(return_value=False)
    mock_cursor = mock_conn.cursor.return_value
    mock_cursor.fetchone.return_value = fetchone_return
    return mock_conn


def test_lookup_plate_name_found():
    """Mock DB returning plate_name → return plate_name."""
    mock_conn = _make_db_mock(("半導體",))

    with patch("backend.models.plate.get_connection", return_value=mock_conn):
        result = _lookup_plate_name("HK.LIST1013")

    assert result == "半導體"


def test_lookup_plate_name_not_found():
    """Mock DB returning None → fallback to plate_code."""
    mock_conn = _make_db_mock(None)

    with patch("backend.models.plate.get_connection", return_value=mock_conn):
        result = _lookup_plate_name("HK.LIST9999")

    assert result == "HK.LIST9999"  # fallback to plate_code


# ============================================================================
# Test _rank_one_plate (integration, mocked ctx + DB)
# ============================================================================

def test_rank_one_plate_full_pipeline():
    """Full pipeline: resolve → filter → fetch → filter valid → rank → top N."""
    # Mock ctx
    mock_ctx = Mock()
    mock_plate_df = pd.DataFrame({"code": ["HK.00981", "HK.01347", "HK.00522"]})
    mock_ctx.get_plate_stock.return_value = (RET_OK, mock_plate_df)
    mock_snapshot_df = pd.DataFrame([
        make_snapshot("HK.00981", turnover=1000000.0, total_market_val=2000.0),
        make_snapshot("HK.01347", turnover=500000.0, total_market_val=1000.0),
        make_snapshot("HK.00522", turnover=800000.0, total_market_val=1500.0),
    ])
    mock_ctx.get_market_snapshot.return_value = (RET_OK, mock_snapshot_df)

    # Mock DB (plate_name lookup)
    mock_conn = _make_db_mock(("半導體",))

    with patch("backend.models.plate.get_connection", return_value=mock_conn):
        leaders = _rank_one_plate(mock_ctx, "HK.LIST1013", top_n=2, plate_name_cache={})

    # Expected: top 2 by composite score
    # 00981: mcap_rank=1, vol_rank=1, score=2
    # 01347: mcap_rank=3, vol_rank=3, score=6
    # 00522: mcap_rank=2, vol_rank=2, score=4
    # top 2 by score: 00981 (2), 00522 (4)
    assert len(leaders) == 2
    assert leaders[0]["code"] == "HK.00981"  # rank 1
    assert leaders[0]["plate_name"] == "半導體"
    assert leaders[1]["code"] == "HK.00522"
    assert leaders[1]["plate_name"] == "半導體"


def test_rank_one_plate_pre_market():
    """REGRESSION: pre-market (turnover=0) should still return top N leaders."""
    mock_ctx = Mock()
    mock_plate_df = pd.DataFrame({"code": ["HK.00981", "HK.01347"]})
    mock_ctx.get_plate_stock.return_value = (RET_OK, mock_plate_df)
    # PRE-MARKET: turnover=0 (大少 09:03 regression)
    mock_snapshot_df = pd.DataFrame([
        make_snapshot("HK.00981", turnover=0.0, total_market_val=2000.0),
        make_snapshot("HK.01347", turnover=0.0, total_market_val=1000.0),
    ])
    mock_ctx.get_market_snapshot.return_value = (RET_OK, mock_snapshot_df)

    mock_conn = _make_db_mock(("半導體",))

    with patch("backend.models.plate.get_connection", return_value=mock_conn):
        leaders = _rank_one_plate(mock_ctx, "HK.LIST1013", top_n=2, plate_name_cache={})

    assert len(leaders) == 2, "Pre-market stocks should be VALID"
    assert all(l["turnover"] == 0.0 for l in leaders)


# ============================================================================
# Test run_plate_leaders (integration, mocked ctx + DB)
# ============================================================================

def test_run_plate_leaders_multiple_plates():
    """Multi-plate: 3 plates × top 2 = 6 leaders (per-plate concat)."""
    mock_ctx = Mock()
    # Each plate returns same 2 stocks (different plate_codes → cache miss per call)
    mock_plate_df = pd.DataFrame({"code": ["HK.00981", "HK.01347"]})
    mock_ctx.get_plate_stock.return_value = (RET_OK, mock_plate_df)
    mock_snapshot_df = pd.DataFrame([
        make_snapshot("HK.00981", turnover=1000000.0, total_market_val=2000.0),
        make_snapshot("HK.01347", turnover=500000.0, total_market_val=1000.0),
    ])
    mock_ctx.get_market_snapshot.return_value = (RET_OK, mock_snapshot_df)

    # Mock DB: 不同 plate_code 返不同 plate_name
    plate_name_map = {
        "HK.LIST1013": "半導體",
        "HK.LIST1044": "煤炭",
        "HK.LIST1014": "衛星",
    }

    def make_db_for_plate(plate_code):
        def fetchone():
            return (plate_name_map.get(plate_code, plate_code),)
        mock_conn = MagicMock()
        mock_conn.__enter__ = Mock(return_value=mock_conn)
        mock_conn.__exit__ = Mock(return_value=False)
        mock_conn.cursor.return_value.fetchone.side_effect = fetchone
        return mock_conn

    # 因為 mock_conn.fetchone.side_effect 跟 plate_code，每次 call 都用新 mock
    # 用 side_effect on get_connection patch 來動態返唔同 mock_conn
    mock_conn_pool = {
        "HK.LIST1013": make_db_for_plate("HK.LIST1013"),
        "HK.LIST1044": make_db_for_plate("HK.LIST1044"),
        "HK.LIST1014": make_db_for_plate("HK.LIST1014"),
    }

    def get_connection_side_effect():
        # 根據最後 call 嘅 plate_code 返對應 mock_conn
        # 但 plate_code 唔直接 available here, so 用 mock_conn_pool 嘅 mock_conn
        # Simpler: 用 list iterator
        for conn in mock_conn_pool.values():
            return conn
        return mock_conn_pool["HK.LIST1013"]

    with patch("backend.models.plate.get_connection", side_effect=lambda: list(mock_conn_pool.values())[0]):
        leaders = run_plate_leaders(
            ["HK.LIST1013", "HK.LIST1044", "HK.LIST1014"],
            top_n=2,
        )

    # 簡化 assert: 只 check leaders 數量 + plate_name 順序
    assert len(leaders) == 6  # 3 plates × top 2
    assert all("plate_name" in l for l in leaders)


def test_run_plate_leaders_empty_plates():
    """Empty plates list → empty leaders."""
    leaders = run_plate_leaders([], top_n=10)
    assert leaders == []


def test_run_plate_leaders_top_n_out_of_range():
    """top_n out of range → fallback to 10 (verified via _rank_one_plate call args)."""
    # 補以 _rank_one_plate mock 驗證 fallback 邏輯 (避免 full integration 容易受 Mock state 影響)
    with patch("backend.models.plate._rank_one_plate", return_value=[]) as mock_rank:
        leaders = run_plate_leaders(["HK.LIST1013"], top_n=100)  # out of range (>50)

    # top_n should fallback to 10 (驗證傳入 _rank_one_plate 嘅 top_n 參數)
    assert mock_rank.call_count == 1
    call_top_n = mock_rank.call_args[0][2]  # 3rd positional arg
    assert call_top_n == 10, f"top_n fallback 失敗: got {call_top_n}, expected 10"
    assert leaders == []


def test_run_plate_leaders_top_n_negative():
    """top_n <= 0 → fallback to 10."""
    with patch("backend.models.plate._rank_one_plate", return_value=[]) as mock_rank:
        leaders = run_plate_leaders(["HK.LIST1013"], top_n=-5)  # negative

    call_top_n = mock_rank.call_args[0][2]
    assert call_top_n == 10
    assert leaders == []


def test_run_plate_leaders_top_n_in_range():
    """top_n in range → pass through (no fallback)."""
    with patch("backend.models.plate._rank_one_plate", return_value=[]) as mock_rank:
        run_plate_leaders(["HK.LIST1013"], top_n=25)  # in range

    call_top_n = mock_rank.call_args[0][2]
    assert call_top_n == 25, f"top_n in range should pass through: got {call_top_n}"