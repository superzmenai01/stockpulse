# StockPulse Frontend Configuration (Template)
#
# Copy this file to `.env` and customize:
#   cp web/.env.example web/.env
#
# 用法：
# - VITE_API_HOST: 留空 → 自動用 window.location.hostname (支援 LAN 訪問)
# - VITE_API_HOST=192.168.1.64 → 強制用特定 host (e.g. 其他電腦固定訪問 MacBook)
# - VITE_API_PORT: 預設 18792 (StockPulse Backend port)

# VITE_API_HOST=
VITE_API_PORT=18792